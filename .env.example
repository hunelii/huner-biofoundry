# Public production HTTPS origin. Leave blank until the domain is confirmed.
NEXT_PUBLIC_SITE_URL=
# Enable on the production deployment only, after approval and public checks.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Public business enquiry address (rendered on the site).
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional; no third-party trackers load when IDs are blank or before consent.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Optional Search Console URL-prefix verification token; DNS verification is preferred.
GOOGLE_SITE_VERIFICATION=
